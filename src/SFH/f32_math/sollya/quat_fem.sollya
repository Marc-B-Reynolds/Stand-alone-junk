//f32_build_constrained(F, ebasis6, x0, x1, 0.5*tx).approx;
//f32_build_constrained(F, ebasis7, x0, x1, 0.5*tx).approx;

// the 2 promote to 64-bit kernels
//f64_build(F, rbasis7, x0, x1).approx;
//f64_build(F, rbasis8, x0, x1).approx;


procedure qem_find_cut_exact(basis)
{
  builder_basis=basis;
  return find_cut(qem_build_exact, x0, x1);
};

procedure qem_find_cut_relaxed(basis)
{
  builder_basis=basis;
  return find_cut(qem_build_relaxed, x0, x1);
};



p3 = qem_relaxed(rbasis3);
p4 = qem_relaxed(rbasis4);
p5 = qem_relaxed(rbasis5);
p6 = qem_relaxed(rbasis6);
p7 = qem_relaxed(rbasis7);

p6;
p7;

display=hexadecimal!;
p7;


