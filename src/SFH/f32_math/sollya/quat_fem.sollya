// -*- coding: utf-8; mode: c -*-

// Using the exponential map to perform unit quaternion to unit ball:
//
//   Q = A + w    (unit)
//   B = f(w) A   (result)  B = (2/pi) log(Q)
//
//   f(w) = (2/pi) acos(w)/sin(acos(w))
//        = (2/pi) acos(w)/sqrt(1-w²)
//
// one way to approximation acos directly on [0,1] can be
// formed by:  acos(x) ≈ P(x) sqrt(1-x)
//
//   f(w) ≈ P(w) sqrt(1-w)/sqrt(1-w²) 
//        ≈ P(w)/sqrt(1+w)
//
// with sufficiently accurate P (or forcing the constant term):
//   let a = 1/sqrt(1+w)
//
//   f(w) ≈ a P(w) = a (1 + w K(w)) = a + aw K(w)

execute("util.sollya");

// set up some globals.
E  = absolute;   //  f(0) = 1 & f(1) = 2/π. So effectively on a single PoT range 
B  = [|SG...|];
F  = (2/pi)*acos(x)/sqrt(1-x^2);

// term on each mononomial. doing it this is a PITA for looking at output but
// doesn't require reworking everything (approximated function and error measures)
tx = 1/sqrt(1+x);

// range set to avoid bad control points
x0 = 0;
x1 = 1 - 2^-25;  // 1 - ulp(1)/2
R  = [x0 ; x1];

execute("util.sollya");

print("//**** direct polynomials\n");

basis = [|1|];

// NOTE: promoting to doubles to compute the polynomial isn't helpful. Likewise
// for an extended precision 'x' coefficient.
for i from 2 to 10 do
{
  var approx;
  var zeroes;
  
  basis  = basis :.i;
  approx = fpminimax(F, [|0|] @ basis, [|SG...|],R,absolute);

  // force constant term to 1. In cases where it isn't automatically
  // will fail to converge without perform the initial step allowing
  // it to be optimizied.
  if (coeff(approx,0) != 1) then {
    zeroes = dirtyfindzeros(F-approx, R);
    approx = fpminimax(F,basis,[|SG...|],zeroes,absolute,1);
  };

  print("// ~abs  error =", dirtyinfnorm(approx-F,R));
  print("// ~f(1) error =", abs(single(2/pi)-single(approx(1))));
  f32_write_list("P",list_of_coeff(approx));

  print("");
};


procedure qem_relaxed(builder_basis)
{
  var r;

  r.arange  = [x0;x1];
  r.approx = fpminimax(F, builder_basis, B, r.arange, floating, E);
  r.aerror = single(dirtyinfnorm(r.approx-F, r.arange));

  return r;
};


// f(0) relaxed approx
procedure qem_build_relaxed(builder_basis)
{
  var r;

  r.arange  = [x0;x1];
  r.approx = fpminimax(F, builder_basis, B, r.arange, floating, E);
  r.aerror = single(dirtyinfnorm(r.approx-F, r.arange));

  return r;
};

// f(0) exact approx
procedure qem_build_exact(builder_basis)
{
  var r;

  r.arange  = [x0;x1];
  r.approx = fpminimax(F, builder_basis, B, r.arange, floating, E, tx);
  r.aerror = single(dirtyinfnorm(r.approx-F, r.arange));

  return r;
};


print("*******  P(w)/sqrt(1+w) approximations. see comments in file.\n");

rbasis2 = [|tx,tx*x|];
rbasis3 = rbasis2 :. tx*x^2;
rbasis4 = rbasis3 :. tx*x^3;
rbasis5 = rbasis4 :. tx*x^4;
rbasis6 = rbasis5 :. tx*x^5;
rbasis7 = rbasis6 :. tx*x^6;
rbasis8 = rbasis7 :. tx*x^7;
rbasis9 = rbasis8 :. tx*x^8;

ebasis2 = [|tx*x|];
ebasis3 = ebasis2 :. tx*x^2;
ebasis4 = ebasis3 :. tx*x^3;
ebasis5 = ebasis4 :. tx*x^4;
ebasis6 = ebasis5 :. tx*x^5;
ebasis7 = ebasis6 :. tx*x^6;
ebasis8 = ebasis7 :. tx*x^7;
ebasis9 = ebasis8 :. tx*x^8;

p7 = qem_build_relaxed(rbasis7);
//p7 = qem_build_exact(ebasis7);
p8 = qem_relaxed(rbasis8);

display=decimal!;
p7;
display=hexadecimal!;
p7.approx;

print("");
display=decimal!;
p8;
display=hexadecimal!;
p8.approx;
