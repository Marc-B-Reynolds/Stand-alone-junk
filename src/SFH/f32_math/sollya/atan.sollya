// -*- coding: utf-8 -*-
// -*- mode: c; -*- 

// classic polynomial approximation of atan on [-tan(π/8),tan(π/8)]
// small ULP kernels are rational approximations
// x + x^3 P(x^2)

// set up some globals
x0 = 0+2^-150;
x1 = tan(pi/8);

execute("util.sollya");

// x + x^3 P(x^2)
procedure atan_build(basis, x0,x1)
{
  var r,c;

  // build the approximation and dump P. need to drop
  // the coefficient of 'x' (which is constrained to 1)
  r = f32_build_constrained(atan(x), basis, x0, x1, x);
  c = tail(list_of_odd_coeff(r.approx));

  print("// ~abs error =", r.aerror);
  print("// ~rel error =", r.rerror);
  //f32_print_kernel_list("f32_atan_k" @ (length(c)-1) , c);
  display=hexadecimal!;
  c;
  display=decimal!;
  print("\n");
  
  return r;
};

print("gross on [-1,1]");
G0 = fpminimax(atan(x), [|x,x*abs(x)|], [|SG...|], [2^-128;1], floating, absolute);
print("//  norm = ", accurateinfnorm(tan(x)-G0, [2^-128;1], 24));
display=hexadecimal!;
G0;
display=decimal!;
G0;
print("");


print("on [-tan(pi/8), tan(pi/8)]");
//P2 = atan_build([|3,5|],     x0,x1);  
P3 = atan_build([|3,5,7|],   x0,x1);
P4 = atan_build([|3,5,7,9|], x0,x1);

if (false) then {
print("on [-1,1]");
x1 = 1+2^-25;
atan_build([|3,5,7,9|], x0,x1);
atan_build([|3,5,7,9,11|], x0,x1);
 atan_build([|3,5,7,9,11,13|], x0,x1);  // this is out about 100 ulp
};

quit;

// for promote to double variants of P
procedure atan_build_dp(basis, x0,x1)
{
  var r,c;

  // build the approximation and dump P. need to drop
  // the coefficient of 'x' (which is constrained to 1)
  r = f64_build_constrained(atan(x), basis, x0, x1, x);
  c = tail(list_of_odd_coeff(r.approx));

  print("// ~abs error =", r.aerror);
  print("// ~rel error =", r.rerror);

  //f64_print_kernel_list("f32_atan_d" @ (length(c)-1) , c);
  display=hexadecimal!;
  c;
  display=decimal!;
  print("\n");

  return r;
};

print("on [-1,1]");
x1 = 1+2^-25;

D4 = atan_build_dp([|3,5,7,9|],    x0,x1);
D5 = atan_build_dp([|3,5,7,9,11|], x0,x1);
D6 = atan_build_dp([|3,5,7,9,11,13|], x0,x1);
D7 = atan_build_dp([|3,5,7,9,11,13,15|], x0,x1);

if (false) then {
D7 = fpminimax(atan(x), [|3,5,7,9,11,13|], [|106,D...|],[x0;x1], x, relative);
c = tail(list_of_odd_coeff(D7));

display=hexadecimal!;
  c;
  display=decimal!;
  print("\n");
};
