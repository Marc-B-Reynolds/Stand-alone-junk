// -*- mode: c; -*- 

execute("util.sollya");

F  = cos(pi*x/2);
x0 = 0;
x1 = 1-2^-48;
R  = [x0;x1];

// polynomial approximations of cos(pi/2 x) on [0,1]
// for (scaled) unit quaternion exp

print("//**** w term: this is an even polynomial to the printed x*x in code is the norm of the input (i.e. dot(v,v))\n");

procedure w_build(basis, x0,x1)
{
  var r;

  r = f32_build_ae(cos(pi*x/2), basis, x0, x1);

  print("// ~abs error =", r.aerror);
  print("// ~rel error =", r.rerror);
  f32_print_kernel_even("f32_iem_k", r.approx);
  
  return r;
};

basis = [|0,2,4,6,8,10|];
A     = w_build(basis, x0,x1);

// initial version without fixed constant of one. explodes without
// this step.
basis = [|0,2,4,6,8|];
T5    = fpminimax(F, basis, [|SG...|],R,absolute);
L5    = dirtyfindzeros(F-T5, R);
A5    = fpminimax(F, [|2,4,6,8|], [|SG...|],L5,absolute,1);

print("// ~abs error =", dirtyinfnorm(A5-F,R));
f32_print_kernel_even("f32_iem_k",A5);


basis = [|0,2,4,6|];
T4    = fpminimax(F, basis, [|SG...|],R,absolute);
L4    = dirtyfindzeros(F-T4, R);
A4    = fpminimax(F, [|2,4,6|], [|SG...|],L4,absolute,1);

print("// ~abs error =", dirtyinfnorm(A4-F,R));
f32_print_kernel_even("f32_iem_k",A4);



